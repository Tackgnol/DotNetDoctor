<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RepoDoctor.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RepoDoctor.Core\RepoDoctor.Core.csproj" />
    <ProjectReference Include="..\..\src\RepoDoctor.Analysis\RepoDoctor.Analysis.csproj" />
    <ProjectReference Include="..\..\src\RepoDoctor.Cli\RepoDoctor.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\profiles\bootstrap-server-core.json" Link="profiles\bootstrap-server-core.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\profiles\dotnet-code-quality.json" Link="profiles\dotnet-code-quality.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="[10.0.303]" />
    <PackageDownload Include="Meziantou.Analyzer" Version="[3.0.224]" />
  </ItemGroup>

  <PropertyGroup>
    <BundledAnalyzerRoot>$(NuGetPackageRoot)</BundledAnalyzerRoot>
    <BundledAnalyzerRoot Condition="'$(BundledAnalyzerRoot)' == ''">$(NuGetPackageFolders)</BundledAnalyzerRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(BundledAnalyzerRoot)microsoft.codeanalysis.netanalyzers\10.0.303\analyzers\dotnet\Microsoft.CodeAnalysis.NetAnalyzers.dll;$(BundledAnalyzerRoot)microsoft.codeanalysis.netanalyzers\10.0.303\analyzers\dotnet\cs\Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll;$(BundledAnalyzerRoot)meziantou.analyzer\3.0.224\analyzers\dotnet\roslyn5.6\cs\Meziantou.Analyzer.dll"
          Link="bundled-analyzers\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
